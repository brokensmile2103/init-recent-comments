{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "init-recent-comments/user-recent-reviews",
    "title": "User Recent Reviews",
    "category": "init-recent-comments",
    "icon": "star-half",
    "description": "Insert the most recent reviews submitted by a specific user. Requires Init Review System.",
    "keywords": ["reviews", "user", "author", "init"],
    "textdomain": "init-recent-comments",
    "attributes": {
        "userId": {
            "type": "number",
            "default": 0
        },
        "number": {
            "type": "number",
            "default": 5
        },
        "status": {
            "type": "string",
            "default": "approved"
        },
        "maxHeight": {
            "type": "string",
            "default": ""
        },
        "theme": {
            "type": "string",
            "default": ""
        },
        "paged": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "className": false,
        "customClassName": false
    },
    "editorScript": "init-recent-comments-blocks-editor",
    "style": "init-recent-comments-style",
    "render": "file:./render.php"
}
