{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "init-recent-comments/recent-reviews",
    "title": "Recent Reviews",
    "category": "init-recent-comments",
    "icon": "star-filled",
    "description": "Insert the most recent approved reviews site-wide. Requires Init Review System.",
    "keywords": ["reviews", "recent", "init"],
    "textdomain": "init-recent-comments",
    "attributes": {
        "number": {
            "type": "number",
            "default": 5
        },
        "maxHeight": {
            "type": "string",
            "default": ""
        },
        "theme": {
            "type": "string",
            "default": ""
        },
        "paged": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "className": false,
        "customClassName": false
    },
    "editorScript": "init-recent-comments-blocks-editor",
    "style": "init-recent-comments-style",
    "render": "file:./render.php"
}
